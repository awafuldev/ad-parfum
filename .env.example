# ==============================================================================
# FRAGANCE STOCK RD — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Administrative Access
# Password required to enter /admin dashboard
ADMIN_PASSWORD=ad2026

# Supabase Database & Storage Configuration (Optional; persistent local storage active by default)
# When provided, the application connects directly to PostgreSQL tables created by migrations
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# WhatsApp Customer Support & Delivery Coordination (Dominican Republic)
NEXT_PUBLIC_WHATSAPP_PHONE=18096788027
