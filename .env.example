# ==============================================================================
# EIDI PARFUM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Administrative Access
# Password required to enter /admin dashboard
ADMIN_PASSWORD=eidi2026

# Supabase Database & Storage Configuration (Optional for initial demo; persistent local storage active by default)
# When provided, the application connects directly to PostgreSQL tables created by migrations
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Payment Gateway Integrations (Awaiting store production merchant accounts)
# Wompi Colombia (Recommended for Bancolombia, Nequi, and local cards)
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxx

# WhatsApp Customer Support & Delivery Coordination
NEXT_PUBLIC_WHATSAPP_PHONE=573001234567
